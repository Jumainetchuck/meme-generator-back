# Root .env example - NestJS Meme Generator Backend
# Copy this file to .env and update the values

# Main API Gateway runs on port 3000
API_GATEWAY_PORT=3000

# Base URL for frontend communication
FRONTEND_URL=http://localhost:5173

# Database configuration (for migrations and development)
DATABASE_URL="mysql://root:password@localhost:3306/db_meme_generator"

# JWT Configuration (shared across services)
JWT_SECRET="your-secret-key-here-change-this-in-production"
JWT_EXPIRATION=7d

# File Upload Configuration
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# Service URLs (internal communication)
AUTH_SERVICE_URL=http://localhost:5552
MEME_SERVICE_URL=http://localhost:5553
MEDIA_SERVICE_URL=http://localhost:5554

# AWS S3 Configuration (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=memes

# Email Configuration (For notifications)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-email@gmail.com
# MAIL_PASS=your-app-password
