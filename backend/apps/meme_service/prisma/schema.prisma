// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"  //  isolé par service, c'est mieux ainsi a cause de mon architecture microservices, chaque service a son propre client prisma
  //   output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MemeVisibility {
  PRIVATE
  PUBLIC
  TEMPORARY
}

enum MemeStatus {
  DRAFT
  COMPLETED
  DELETED
}

