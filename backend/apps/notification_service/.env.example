# Media Service .env example
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/db_media_meme_generator"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="db_media_meme_generator"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# Service Port
PORT=5554

# File Storage Configuration
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# Meme Service URL (for internal calls)
MEME_SERVICE_URL=http://localhost:5553

# AWS S3 Configuration (Optional - for cloud storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=memes-bucket
